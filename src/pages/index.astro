---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Strengths from "../components/Strengths.astro";
import Services from "../components/Services.astro";
import CtaBand from "../components/CtaBand.astro";
import Audience from "../components/Audience.astro";
import About from "../components/About.astro";
import Equipment from "../components/Equipment.astro";
import Process from "../components/Process.astro";
import Zone from "../components/Zone.astro";
---

<BaseLayout
  title="Axial Nettoyage | Nettoyage professionnel à Montpellier"
  description="Nettoyage sur mesure de bureaux, immeubles et chantiers à Montpellier et dans l’Hérault, depuis 15 ans. Devis gratuit."
>
  <Hero />
  <!--
    Shared wrapper so a powder-blue gradient can start right under the hero,
    show through the glass strengths bar, and fade to ice white in the services.
    isolate: the gradient (-z-10) stays behind both sections but in front of the hero.
    top-8 / md:top-16: starts exactly at the hero's bottom edge
    (the strengths bar overlaps the hero by 2rem on phones, 4rem from md up).
  -->
  <div class="relative isolate">
    <div
      class="absolute inset-x-0 top-8 -z-10 h-224 bg-linear-to-b from-powder via-powder/50 to-transparent md:top-16"
      aria-hidden="true"
    ></div>
    <Strengths />
    <Services />
  </div>
  <!-- {"…"} instead of "…" so   (non-breaking space before ? and :) works:
       inside props, &nbsp; would show up as literal text -->
  <CtaBand
    photo
    title={"Besoin d’un vrai coup de propre\u00a0?"}
    text={"Surface, fréquence, accès\u00a0: on vous répond vite."}
  />
  <Audience />
  <About />
  <Equipment />
  <Process />
  <Zone />
  <CtaBand
    eyebrow="Devis gratuit et sans engagement"
    title="Parlons de vos locaux"
    text="Un appel suffit pour comprendre vos besoins. Nous vous proposons ensuite un devis adapté à la surface et à la fréquence souhaitées."
    phone
  />
</BaseLayout>
