---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Strengths from "../components/Strengths.astro";
import Services from "../components/Services.astro";
import CtaBand from "../components/CtaBand.astro";
import Audience from "../components/Audience.astro";
import About from "../components/About.astro";
import Equipment from "../components/Equipment.astro";
import Process from "../components/Process.astro";
import Zone from "../components/Zone.astro";
---

<BaseLayout
  title="Axial Nettoyage | Nettoyage professionnel à Montpellier"
  description="Nettoyage sur mesure de bureaux, immeubles et chantiers à Montpellier et dans l’Hérault, depuis 15 ans. Devis gratuit."
>
  <Hero />
  <Strengths />
  <Services />
  <!-- {"…"} instead of "…" so   (non-breaking space before ? and :) works:
       inside props, &nbsp; would show up as literal text -->
  <CtaBand
    title={"Vous voulez un prix pour vos locaux ?"}
    text={"Décrivez-nous votre site : surface, fréquence, contraintes d’accès. Nous vous répondons avec un devis adapté, et nous passons sur place si c’est utile."}
  />
  <Audience />
  <About />
  <Equipment />
  <Process />
  <Zone />
  <CtaBand
    eyebrow="Devis gratuit et sans engagement"
    title="Parlons de vos locaux"
    text="Un appel suffit pour comprendre vos besoins. Nous vous proposons ensuite un devis adapté à la surface et à la fréquence souhaitées."
    phone
  />
</BaseLayout>
