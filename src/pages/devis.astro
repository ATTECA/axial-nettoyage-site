---
// /devis: quote request page.
// Structure from the wireframe: intro, form, "what happens next", FAQ.
// The form is sent with Web3Forms (see the <script> at the bottom).
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import TitleStreak from "../components/TitleStreak.astro";
import { site, services, phoneHref, emailHref } from "../data/site";
import { sectionX, eyebrow, gradientText } from "../lib/layout";
import { glossy, glossyBlue, arrow } from "../lib/buttons";

// Web3Forms access key: created on web3forms.com with the address that
// should RECEIVE the requests. It's meant to be public (it only allows
// sending to that one address), so it can live in the code.
// TODO: replace with the real key once the receiving address is confirmed
const web3formsKey = "YOUR_ACCESS_KEY_HERE";

const premises = ["Bureaux", "Parties communes / copropriété", "Bâtiment industriel / entrepôt", "Chantier", "Commerce", "Autre"];
const surfaces = ["Moins de 100 m²", "100 à 300 m²", "300 à 1 000 m²", "Plus de 1 000 m²", "Je ne sais pas"];
const frequencies = ["Ponctuelle", "Quotidienne", "Plusieurs fois par semaine", "Hebdomadaire", "Mensuelle"];
const slots = ["Tôt le matin", "En journée", "Le soir", "Le week‑end"];

const steps = [
  { icon: "tabler:writing", title: "Vous nous écrivez", text: "Votre demande nous arrive directement, avec le type de locaux et ce que vous cherchez à couvrir." },
  { icon: "tabler:phone-call", title: "Nous vous rappelons", text: "S’il manque une information, nous vous appelons au numéro indiqué, sans détour par email." },
  { icon: "tabler:map-pin", title: "Nous passons sur place", text: "Pour les sites de plusieurs niveaux ou les prestations particulières, une visite permet de chiffrer juste." },
  { icon: "tabler:file-euro", title: "Vous recevez le devis", text: "Un document détaillé, poste par poste, gratuit et sans engagement de votre part." },
];

const faq = [
  { q: "Le devis est-il vraiment gratuit ?", a: "Oui, entièrement. Le déplacement pour voir vos locaux l’est aussi, et rien ne vous est facturé avant votre accord." },
  { q: "Sous quel délai vais-je être contacté ?", a: `Nous répondons sous 24 heures ouvrées. Pour une demande urgente, le plus rapide reste de nous appeler au ${site.phone}.` },
  { q: "Le devis m’engage-t-il à quelque chose ?", a: "Non. Vous restez libre de le refuser, et le prix est établi en fonction de la surface, de la fréquence et du niveau de finition demandé." },
  { q: "Intervenez-vous en dehors de Montpellier ?", a: "Oui, dans tout l’Hérault. Indiquez votre commune dans le formulaire et nous vous confirmerons notre passage." },
];

// Shared field styles
const label = "block font-heading text-sm font-semibold";
const input =
  "mt-2 block w-full rounded-2xl border border-white bg-white/80 px-4 py-3 text-ink shadow-[inset_0_1px_2px_rgb(22_50_79/0.08)] placeholder:text-ink/40 focus:border-primary focus:ring-4 focus:ring-primary/15 focus:outline-none";
const check = "size-4 shrink-0 rounded border-ink/30 text-primary accent-primary";
const tile =
  "flex size-12 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-secondary to-primary text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.35),0_8px_18px_-8px_rgb(49_123_185/0.7)]";
---

<BaseLayout
  title="Demander un devis | Axial Nettoyage"
  description="Devis gratuit et sans engagement pour le nettoyage de vos locaux à Montpellier et dans l’Hérault. Réponse sous 24 heures ouvrées."
>
  <!-- 1. Intro -->
  <section class:list={[sectionX, "pt-16 md:pt-24"]}>
    <div class="rounded-4xl border border-white bg-linear-to-br from-white/80 to-powder/40 px-6 py-14 text-center shadow-[0_24px_60px_-24px_rgb(22_50_79/0.3)] md:py-20">
      <p class={eyebrow}>Devis gratuit et sans engagement</p>
      <h1 class="mt-3 text-4xl leading-tight font-semibold text-balance md:text-6xl">
        Demander un <span class={gradientText}>devis</span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-ink/70">
        Décrivez vos locaux et vos contraintes d’horaires&nbsp;: nous vous
        remettons un devis détaillé, sans engagement. Une visite sur place est
        possible si vos surfaces le demandent.
      </p>
      <a href={phoneHref} class="mt-7 inline-flex items-center gap-2 font-heading font-semibold text-primary hover:text-ink">
        <Icon name="tabler:phone" class="size-5" />{site.phone}
      </a>
    </div>
  </section>

  <!-- 2. Form -->
  <section class:list={[sectionX, "py-20 md:py-28"]}>
    <div class="grid gap-12 lg:grid-cols-[2fr_3fr] lg:gap-16">
      <!-- Left: why + direct contact (no address: Axial doesn't receive clients) -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-3xl leading-tight font-semibold text-balance md:text-4xl">Décrivez-nous vos locaux</h2>
        <TitleStreak class="mt-5" />
        <p class="mt-6 text-lg text-pretty text-ink/70">
          Remplissez ce formulaire et nous revenons vers vous avec un devis
          détaillé. Vous préférez le téléphone&nbsp;? Appelez-nous, c’est souvent
          plus direct pour un premier échange.
        </p>
        <ul class="mt-8 flex flex-col gap-5">
          <li class="flex items-center gap-4">
            <span class={tile}><Icon name="tabler:phone" class="size-5" /></span>
            <div>
              <p class="text-sm text-ink/60">Téléphone</p>
              <a href={phoneHref} class="font-heading text-lg font-semibold text-primary hover:text-ink">{site.phone}</a>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <span class={tile}><Icon name="tabler:mail" class="size-5" /></span>
            <div>
              <p class="text-sm text-ink/60">Email</p>
              <a href={emailHref} class="font-heading font-semibold break-all text-primary hover:text-ink">{site.email}</a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Right: the form -->
      <form
        id="devis-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col gap-6 rounded-4xl border border-white bg-white/60 p-6 shadow-[0_24px_60px_-24px_rgb(22_50_79/0.35)] backdrop-blur-xl md:p-10"
      >
        <!-- Web3Forms settings (hidden) -->
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="from_name" value="Site Axial Nettoyage" />
        <input type="hidden" name="subject" value="Nouvelle demande de devis" />
        <!-- Honeypot: invisible to people, bots fill it and get ignored -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="name" class={label}>Nom et prénom *</label>
            <input id="name" name="Nom" required autocomplete="name" placeholder="Jean Dupont" class={input} />
          </div>
          <div>
            <label for="company" class={label}>Société ou organisation *</label>
            <input id="company" name="Société" required autocomplete="organization" placeholder="Entreprise ou copropriété" class={input} />
          </div>
          <div>
            <label for="phone" class={label}>Téléphone *</label>
            <input id="phone" name="Téléphone" type="tel" required autocomplete="tel" placeholder="06 12 34 56 78" class={input} />
          </div>
          <div>
            <label for="email" class={label}>Email *</label>
            <!-- name="email": Web3Forms uses it as the reply-to address -->
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="vous@entreprise.fr" class={input} />
          </div>
        </div>

        <div>
          <label for="city" class={label}>Commune d’intervention *</label>
          <input id="city" name="Commune" required placeholder="Montpellier, Lattes, Sète…" class={input} />
        </div>

        <!-- Several services possible: checkboxes. "required" on a group of
             checkboxes isn't native: the script checks at least one is ticked -->
        <fieldset data-group="prestations">
          <legend class={label}>Prestation(s) souhaitée(s) *</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {services.map((s) => (
              <label class="flex items-center gap-3 rounded-xl px-1 py-1 text-ink/80">
                <input type="checkbox" name="Prestations" value={s.title} class={check} />
                {s.title}
              </label>
            ))}
          </div>
          <p class="group-error mt-2 hidden text-sm font-medium text-red-600">Choisissez au moins une prestation.</p>
        </fieldset>

        <div class="grid gap-6 sm:grid-cols-3">
          <div>
            <label for="premises" class={label}>Type de locaux *</label>
            <select id="premises" name="Type de locaux" required class={input}>
              {premises.map((p) => <option>{p}</option>)}
            </select>
          </div>
          <div>
            <label for="surface" class={label}>Surface approximative</label>
            <select id="surface" name="Surface" class={input}>
              {surfaces.map((s) => <option>{s}</option>)}
            </select>
          </div>
          <div>
            <label for="frequency" class={label}>Fréquence souhaitée</label>
            <select id="frequency" name="Fréquence" class={input}>
              {frequencies.map((f) => <option>{f}</option>)}
            </select>
          </div>
        </div>

        <fieldset>
          <legend class={label}>Créneaux préférés</legend>
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {slots.map((s) => (
              <label class="flex items-center gap-3 text-ink/80">
                <input type="checkbox" name="Créneaux" value={s} class={check} />
                {s}
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="details" class={label}>Précisions</label>
          <textarea id="details" name="Précisions" rows="4" placeholder="Contraintes d’accès, besoins particuliers, informations utiles…" class={input}></textarea>
        </div>

        <div>
          <button type="submit" class:list={[glossy, glossyBlue, "inline-flex px-7 py-3.5 disabled:opacity-60"]}>
            <span data-label>Envoyer ma demande</span>
            <Icon name="tabler:arrow-right" class={arrow} />
          </button>
          <p class="mt-4 text-sm text-pretty text-ink/60">
            Vos informations servent uniquement à répondre à votre demande. En savoir plus dans notre{" "}
            <a href="/confidentialite" class="underline hover:text-primary">politique de confidentialité</a>.
          </p>
          <!-- Result message, filled by the script. role="status" = read aloud by screen readers -->
          <p id="devis-result" role="status" class="mt-4 hidden rounded-2xl px-4 py-3 font-medium"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- 3. What happens next -->
  <section class:list={[sectionX, "pb-20 md:pb-28"]}>
    <p class={eyebrow}>Sans engagement</p>
    <h2 class="mt-3 text-3xl leading-tight font-semibold text-balance md:text-4xl">Ce qui se passe après l’envoi</h2>
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li>
          <span class={tile}><Icon name={s.icon} class="size-6" /></span>
          <h3 class="mt-5 text-xl font-semibold text-balance">{s.title}</h3>
          <p class="mt-2 text-pretty text-ink/70">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 4. FAQ: <details> = open/close without JavaScript -->
  <section class:list={[sectionX, "pb-20 md:pb-28"]}>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-3xl leading-tight font-semibold text-balance md:text-4xl">Questions sur le devis</h2>
        <p class="mt-4 text-lg text-ink/70">Ce qu’on nous demande le plus souvent avant de remplir le formulaire.</p>
      </div>
      <div class="divide-y divide-ink/10 border-y border-ink/10">
        {faq.map((f, i) => (
          <details class="group py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold">
              {f.q}
              <Icon name="tabler:chevron-down" class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-pretty text-ink/70">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Sends the form to Web3Forms without leaving the page, then shows a
  // message. Without JavaScript, the form still works (normal POST).
  const form = document.getElementById("devis-form") as HTMLFormElement | null;
  const result = document.getElementById("devis-result")!;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    // At least one service ticked (checkbox groups have no native "required")
    const group = form.querySelector<HTMLElement>('[data-group="prestations"]')!;
    const ticked = group.querySelectorAll("input:checked").length > 0;
    group.querySelector(".group-error")!.classList.toggle("hidden", ticked);
    if (!ticked) {
      group.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.querySelector("[data-label]")!;
    button.disabled = true;
    label.textContent = "Envoi en cours…";

    // Several ticked boxes with the same name -> one line "A, B, C"
    const data = new FormData(form);
    const payload: Record<string, string> = {};
    for (const [key, value] of data.entries()) {
      payload[key] = payload[key] ? `${payload[key]}, ${value}` : String(value);
    }
    payload.subject = `Nouvelle demande de devis – ${payload["Commune"] ?? ""}`;

    const show = (ok: boolean, text: string) => {
      result.textContent = text;
      result.className = `mt-4 rounded-2xl px-4 py-3 font-medium ${ok ? "bg-accent/25 text-ink" : "bg-red-50 text-red-700"}`;
    };

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await response.json();
      if (json.success) {
        form.reset();
        show(true, "Merci, votre demande est bien envoyée. Nous revenons vers vous sous 24 heures ouvrées.");
      } else {
        throw new Error(json.message);
      }
    } catch {
      show(false, "L’envoi n’a pas fonctionné. Réessayez, ou appelez-nous directement.");
    } finally {
      button.disabled = false;
      label.textContent = "Envoyer ma demande";
    }
  });
</script>
