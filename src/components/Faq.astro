---
// FAQ section: title + intro on the left, questions on the right.
// <details> = opens and closes without JavaScript. The first one is open.
// Used by /devis and /contact.
import { Icon } from "astro-icon/components";
import { sectionX } from "../lib/layout";

interface Props {
  title: string;
  intro: string;
  items: { q: string; a: string }[];
}

const { title, intro, items } = Astro.props;
---

<section class:list={[sectionX, "pb-20 md:pb-28"]}>
  <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="text-3xl leading-tight font-semibold text-balance md:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-ink/70">{intro}</p>
    </div>
    <div class="divide-y divide-ink/10 border-y border-ink/10">
      {
        items.map((item, i) => (
          <details class="group py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold">
              {item.q}
              <Icon name="tabler:chevron-down" class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 text-pretty text-ink/70">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
