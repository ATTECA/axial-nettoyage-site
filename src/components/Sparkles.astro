---
// The 4-point stars from the AXIAL logo, scattered around the edges of a
// section and twinkling one after the other. Never in the middle, where the
// text is. Place it inside a "relative isolate overflow-hidden" parent.

interface Props {
  // Changes the layout (same seed = same positions on every build)
  seed?: number;
}

const { seed = 3 } = Astro.props;

// Small predictable random generator
function random(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// true = the point is in the central oval, where the text is
const inMiddle = (x: number, y: number) =>
  ((x - 0.5) / 0.34) ** 2 + ((y - 0.5) / 0.42) ** 2 < 1;

// Evenly spread, but not in a visible grid: the card is cut into
// 8 × 4 cells, and every cell outside the middle gets one star,
// at a random spot inside that cell. So no corner is left empty.
const rand = random(seed);
const cols = 8;
const rows = 4;
const stars: { x: number; y: number; size: number; delay: number }[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    if (inMiddle((col + 0.5) / cols, (row + 0.5) / rows)) continue;
    // Try a few random spots in the cell until one is outside the middle
    let x = 0;
    let y = 0;
    for (let tries = 0; tries < 10; tries++) {
      x = (col + rand()) / cols;
      y = (row + rand()) / rows;
      if (!inMiddle(x, y)) break;
    }
    stars.push({ x: x * 100, y: y * 100, size: 10 + rand() * 26, delay: rand() * 4 });
  }
}

// Same shape and proportions as the logo's star, centred on 0,0
const star = "M0 -20L1.6 -1.6L20 0L1.6 1.6L0 20L-1.6 1.6L-20 0L-1.6 -1.6Z";
---

{
  stars.map((s, i) => (
    <svg
      class="twinkle absolute -z-10"
      style={`left:${s.x.toFixed(1)}%;top:${s.y.toFixed(1)}%;width:${s.size.toFixed(0)}px;animation-delay:${s.delay.toFixed(2)}s`}
      viewBox="-20 -20 40 40"
      aria-hidden="true"
    >
      {/* One star in three is white, the rest lime */}
      <path d={star} fill={i % 3 === 0 ? "white" : "#a8cf45"} />
    </svg>
  ))
}

<style>
  /* Grow, turn a little and glow, then fade back. Each star has its own delay */
  .twinkle {
    transform: translate(-50%, -50%);
    animation: twinkle 4s ease-in-out infinite;
    filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.5));
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.25; transform: translate(-50%, -50%) scale(0.6) rotate(0deg); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(45deg); }
  }
  /* People who turn off animations in their system settings get still stars */
  @media (prefers-reduced-motion: reduce) {
    .twinkle { animation: none; }
  }
</style>
