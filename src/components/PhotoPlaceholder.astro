---
// Stand-in for a photo that isn't ready yet: soft brand gradient + faded icon.
// When the photo arrives, replace <PhotoPlaceholder> with an <Image>
// that has the same classes (aspect ratio + rounded corners).
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className } = Astro.props;
---

<div
  class:list={[
    "flex items-center justify-center overflow-hidden rounded-3xl bg-linear-to-br from-powder/70 via-white to-accent/25 shadow-[0_10px_30px_-12px_rgb(22_50_79/0.15)]",
    className,
  ]}
  aria-hidden="true"
>
  <Icon name={icon} class="size-20 text-primary/30" />
</div>
