---
// Call-to-action card in brand blue, used twice on the home page
// (after the services, and at the very end).
// It's a rounded card inside the page, not a full-width band,
// so the last one doesn't merge into the blue footer below it.
import { Icon } from "astro-icon/components";
import { site, phoneHref } from "../data/site";
import { glossy, glossyLime, glossyWhite, arrow } from "../lib/buttons";
import { sectionX } from "../lib/layout";
import Sparkles from "./Sparkles.astro";
import { Image } from "astro:assets";
import soapPhoto from "../assets/vitre-savon-texte.jpg";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  // true = also show the phone button next to "Demander un devis"
  phone?: boolean;
  // true = the soapy window photo replaces the sparkles
  photo?: boolean;
}

const { eyebrow, title, text, phone = false, photo = false } = Astro.props;
---

<!-- With the photo, more space below: the next section ("Pour qui") is a
     full-width photo band, and the small card looked squashed against it.
     pb = the space above the card (services pb + this pt: 80+40 / 112+56),
     so the card sits exactly in the middle -->
<section class:list={[sectionX, "py-10 md:py-14", photo && "pb-30 md:pb-42"]}>
  <div
    class:list={[
      "relative isolate overflow-hidden rounded-4xl bg-linear-to-br from-primary to-[#25629a] text-center text-white shadow-[0_24px_60px_-24px_rgb(22_50_79/0.6)]",
      // With the photo: the card takes the photo's exact shape
      // (2624 × 1632 px, so no stretching, no cropping), on every screen.
      // No padding: the button below is placed on top of the photo instead.
      // Without the photo: normal padding around the text.
      photo
        ? "mx-auto aspect-2624/1632 max-w-2xl"
        : "mx-auto max-w-5xl px-6 py-16 md:px-12 md:py-20",
    ]}
  >
    <!-- Soft light spots in the corners: lime glow top right, light blue bottom left -->
    <div
      class="absolute -top-24 -right-24 -z-10 size-72 rounded-full bg-accent/25 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -bottom-24 -left-24 -z-10 size-72 rounded-full bg-secondary/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <!-- Sun glare through the clean glass, top left -->
    <div
      class="absolute top-6 left-[22%] -z-10 size-40 rounded-full bg-white/30 blur-3xl"
      aria-hidden="true"
    ></div>

    <!-- Second lime glow, bottom right, to balance the one top right -->
    <div
      class="absolute right-[18%] -bottom-20 -z-10 size-56 rounded-full bg-accent/20 blur-3xl"
      aria-hidden="true"
    ></div>

    <!-- Third lime glow, bottom left, to fill that empty corner -->
    <div
      class="absolute bottom-[-4rem] left-[6%] -z-10 size-60 rounded-full bg-accent/25 blur-3xl"
      aria-hidden="true"
    ></div>

    <!-- Without the photo: the logo's stars twinkling around the edges -->
    {!photo && <Sparkles />}

    <!-- The photo of a squeegee wiping a soapy window,
         with the title already written on the clean glass.
         alt="" because the real title is in the <h2> below (hidden visually,
         but still read by Google and screen readers).
         width + densities: Astro makes a 672 px version and a 1344 px one
         (for retina screens) instead of sending the full 2624 px photo. -->
    {photo && (
      <Image
        src={soapPhoto}
        alt=""
        width={672}
        densities={[1, 2]}
        class="absolute inset-0 -z-10 size-full object-cover"
      />
    )}

    <!-- With the photo: a small box on the bit of clean glass left
         under "coup de propre", where the button goes. Percentages here are
         of the card itself. Tweak top/left to move the button. -->
    <div
      class:list={[
        photo &&
          "absolute top-[69%] left-[41%] flex h-[14%] w-[29%] items-center justify-center",
      ]}
    >
      {eyebrow && (
        <p class="font-heading text-sm font-semibold tracking-widest text-accent uppercase">
          {eyebrow}
        </p>
      )}
      <h2
        class:list={[
          "mx-auto mt-3 max-w-2xl text-3xl leading-tight font-semibold text-balance",
          "md:text-5xl",
          // sr-only = invisible but still there: the photo shows the title
          photo && "sr-only",
        ]}
      >
        {title}
      </h2>
      <p
        class:list={[
          "mx-auto mt-5 max-w-xl text-lg text-pretty text-white/80",
          photo && "sr-only",
        ]}
      >
        {text}
      </p>

      <div
        class:list={[
          "mt-9 flex flex-col justify-center gap-3 sm:flex-row",
          photo && "mt-0",
        ]}
      >
        <!-- With the photo, the button looks like a sticker slapped a bit
             crooked on the clean glass (-rotate-3), with a sparkle icon.
             On hover it straightens up and grows a little.
             On phones the card is half as wide, so the sticker is smaller
             (text-xs, thinner ring, no sparkles); full size from sm up. -->
        <a
          href="/devis"
          class:list={[
            glossy,
            glossyLime,
            "flex justify-center",
            photo
              ? "-rotate-3 gap-1.5 px-3 py-1.5 text-xs ring-2 ring-white/70 duration-300 hover:scale-110 hover:rotate-0 sm:gap-2 sm:px-5 sm:py-2.5 sm:text-sm sm:ring-4"
              : "px-7 py-3.5",
          ]}
        >
          {photo && <Icon name="tabler:sparkles" class="hidden size-4 sm:block" />}
          {photo ? "Devis gratuit" : "Demander un devis"}
          <Icon name="tabler:arrow-right" class={arrow} />
        </a>
        {phone && (
          <a
            href={phoneHref}
            class:list={[
              glossy,
              glossyWhite,
              "flex justify-center px-7 py-3.5",
            ]}
          >
            <Icon name="tabler:phone" class="size-4" />
            {site.phone}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
