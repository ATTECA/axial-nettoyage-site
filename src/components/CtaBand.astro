---
// Call-to-action card in brand blue, used twice on the home page
// (after the services, and at the very end).
// It's a rounded card inside the page, not a full-width band,
// so the last one doesn't merge into the blue footer below it.
import { Icon } from "astro-icon/components";
import { site, phoneHref } from "../data/site";
import { glossy, glossyLime, glossyWhite, arrow } from "../lib/buttons";
import { sectionX } from "../lib/layout";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  // true = also show the phone button next to "Demander un devis"
  phone?: boolean;
}

const { eyebrow, title, text, phone = false } = Astro.props;
---

<section class:list={[sectionX, "py-10 md:py-14"]}>
  <div class="relative isolate overflow-hidden rounded-[2rem] bg-linear-to-br from-primary to-[#25629a] px-6 py-16 text-center text-white shadow-[0_24px_60px_-24px_rgb(22_50_79/0.6)] md:px-12 md:py-20">
    <!-- Soft light spots in the corners: lime glow top right, light blue bottom left -->
    <div class="absolute -top-24 -right-24 -z-10 size-72 rounded-full bg-accent/25 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-24 -left-24 -z-10 size-72 rounded-full bg-secondary/40 blur-3xl" aria-hidden="true"></div>

    {
      eyebrow && (
        <p class="font-heading text-sm font-semibold tracking-widest text-accent uppercase">
          {eyebrow}
        </p>
      )
    }
    <h2 class="mx-auto mt-3 max-w-2xl text-3xl leading-tight font-semibold text-balance md:text-5xl">
      {title}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-white/80">{text}</p>

    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/devis" class:list={[glossy, glossyLime, "flex justify-center px-7 py-3.5"]}>
        Demander un devis
        <Icon name="tabler:arrow-right" class={arrow} />
      </a>
      {
        phone && (
          <a href={phoneHref} class:list={[glossy, glossyWhite, "flex justify-center px-7 py-3.5"]}>
            <Icon name="tabler:phone" class="size-4" />
            {site.phone}
          </a>
        )
      }
    </div>
  </div>
</section>
