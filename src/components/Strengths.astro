---
// "Pourquoi choisir Axial": one long glass bar, pulled up over the bottom
// of the hero photo, with the 4 strengths side by side.
import { Icon } from "astro-icon/components";
import { sectionX } from "../lib/layout";

// The 4 strengths, built with .map() below
const strengths = [
  {
    icon: "tabler:award",
    title: "15 ans d’expérience",
    text: "Locaux professionnels : bureaux, bâtiments et chantiers.",
  },
  {
    icon: "tabler:clock",
    title: "Horaires adaptés",
    // ‑ = non-breaking hyphen: "week-end" never splits across two lines
    text: "Tôt le matin, le soir ou le week‑end, sans gêner votre activité.",
  },
  {
    icon: "tabler:headset",
    title: "Un interlocuteur unique",
    text: "Un responsable dédié, qui connaît votre site et répond directement.",
  },
  {
    icon: "tabler:file-euro",
    title: "Devis gratuit",
    text: "Établi rapidement, après une visite sur site si nécessaire.",
  },
];

// Glass bar, same family as the "Comment ça se passe" cards, but more opaque
// (the hero photo behind is darker and busier):
// - white gradient + backdrop-blur-2xl + backdrop-saturate-150: thick glass
// - inset shadow: bright top edge, where the light hits
// - before: = diagonal reflection band
const glass =
  "relative isolate overflow-hidden rounded-4xl border border-white/60 bg-linear-to-br from-white/85 via-white/70 to-white/60 shadow-[inset_0_1px_0_rgb(255_255_255/0.9),0_24px_60px_-24px_rgb(22_50_79/0.5)] backdrop-blur-2xl backdrop-saturate-150 before:pointer-events-none before:absolute before:-top-1/2 before:-left-1/4 before:-z-10 before:h-[200%] before:w-1/3 before:rotate-[25deg] before:bg-linear-to-r before:from-transparent before:via-white/50 before:to-transparent";
---

<!-- relative z-10 + negative margin: the bar overlaps the bottom of the hero.
     Only a little on phones (the hero text sits right at the bottom there),
     more from tablet up (the hero text is centred, so there's room) -->
<section class:list={[sectionX, "relative z-10 -mt-8 pb-20 md:-mt-16 md:pb-28"]}>
  <!-- sr-only title: invisible, but gives the section a name for Google
       and screen readers (the page goes h1 -> h2 -> h3) -->
  <h2 class="sr-only">Pourquoi choisir Axial Nettoyage</h2>

  <!-- 1 column on phone (lines between items), 2 on tablet,
       4 on large screens (vertical lines between items) -->
  <ul class:list={[glass, "grid divide-y divide-ink/10 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x"]}>
    {
      strengths.map((item) => (
        <li class="flex gap-4 p-6 lg:p-7">
          <!-- Blue glossy icon tile, same family as the glossy buttons -->
          <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-secondary to-primary text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.35),0_8px_18px_-8px_rgb(49_123_185/0.7)]">
            <Icon name={item.icon} class="size-6" />
          </span>
          <div>
            <h3 class="font-semibold text-balance">{item.title}</h3>
            <p class="mt-1 text-sm text-pretty text-ink/75">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
