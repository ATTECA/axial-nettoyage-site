---
// "Back to top" button, bottom right of every page.
// - Round frosted-glass button with an up arrow
// - A ring around it fills up (blue -> lime) as the page scrolls down
// - Hidden at the top of the page, fades in after 600px of scrolling
// - Click = smooth scroll back up (instant for people who turn off animations)
import { Icon } from "astro-icon/components";

// Ring: circle of radius 24 in a 56 × 56 box. Its length (2πr) is used to
// "draw" only part of the stroke (stroke-dasharray / stroke-dashoffset)
const r = 24;
const length = 2 * Math.PI * r;
---

<button
  type="button"
  id="back-to-top"
  aria-label="Retour en haut de la page"
  class="group/top pointer-events-none fixed right-5 bottom-5 z-40 size-14 translate-y-4 rounded-full border border-white/80 bg-white/70 text-primary opacity-0 shadow-[inset_0_1px_0_white,0_12px_30px_-10px_rgb(22_50_79/0.45)] backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:bg-white/90 data-visible:pointer-events-auto data-visible:translate-y-0 data-visible:opacity-100 data-visible:hover:-translate-y-1 md:right-8 md:bottom-8 motion-reduce:transition-none"
>
  <!-- Progress ring. -rotate-90: starts at the top instead of the right -->
  <svg viewBox="0 0 56 56" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
    <defs>
      <linearGradient id="back-to-top-ring" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#317bb9" />
        <stop offset="1" stop-color="#a8cf45" />
      </linearGradient>
    </defs>
    <!-- Faint full track -->
    <circle cx="28" cy="28" r={r} fill="none" stroke="#317bb9" stroke-opacity="0.12" stroke-width="3" />
    <!-- The part that fills up: dashoffset = length (empty) -> 0 (full) -->
    <circle
      cx="28"
      cy="28"
      r={r}
      fill="none"
      stroke="url(#back-to-top-ring)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray={length}
      stroke-dashoffset={length}
      data-ring
    />
  </svg>
  <!-- Arrow, nudges up on hover -->
  <Icon
    name="tabler:arrow-up"
    class="relative mx-auto size-6 transition-transform duration-300 group-hover/top:-translate-y-0.5"
  />
</button>

<script>
  const button = document.getElementById("back-to-top");
  const ring = button?.querySelector<SVGCircleElement>("[data-ring]");

  if (button && ring) {
    const length = Number(ring.getAttribute("stroke-dasharray"));

    // On every scroll: show/hide the button, and fill the ring
    // (0 = top of the page, 1 = bottom)
    const update = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const progress = max > 0 ? scrollY / max : 0;
      ring.style.strokeDashoffset = String(length * (1 - progress));
      button.toggleAttribute("data-visible", scrollY > 600);
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();

    button.addEventListener("click", () => {
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
  }
</script>
