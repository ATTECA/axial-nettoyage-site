// Glossy blue icon tile, same family as the buttons
const tile =
  "flex size-11 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-secondary to-primary text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.35),0_8px_18px_-8px_rgb(49_123_185/0.7)]";
---

<section class:list={[sectionX, "py-20 md:py-28"]}>
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- Left: title, text and contact list -->
    <div>
      <!-- No "Zone d'intervention" label above: the title already says it -->
      <h2 class="max-w-2xl text-4xl leading-tight font-semibold text-balance md:text-5xl">
        Montpellier et tout le département de <span class={gradientText}>l’Hérault</span>
      </h2>
      <span class:list={[streak, "mt-5 w-28"]}></span>
      <p class="mt-5 max-w-xl text-lg text-pretty text-ink/70">
        Un doute sur votre commune&nbsp;? Appelez-nous, nous vous répondons
        directement.
      </p>

      <!-- Towns as pills: reassures visitors, and the names are in the page
           text, so Google can match searches like "nettoyage bureaux Lattes" -->
      <ul class="mt-7 flex max-w-2xl flex-wrap gap-2">
        {
          communes.map((name, i) => (
            <li
              class:list={[
                "rounded-full border px-3.5 py-1 text-sm font-medium shadow-[inset_0_1px_0_white]",
                i === 0
                  ? "border-primary bg-linear-to-b from-secondary to-primary text-white"
                  : "border-white bg-white/70 text-ink/75",
              ]}
            >
              {name}
            </li>
          ))
        }
        <li class="px-2 py-1 text-sm text-ink/50">et toutes les communes du département</li>
      </ul>

      <!-- Phone + hours in one glass card, the important bits in bold -->
      <div class="mt-9 flex flex-col gap-5 rounded-3xl border border-white bg-white/70 p-6 shadow-[0_18px_40px_-20px_rgb(22_50_79/0.25)] sm:flex-row sm:gap-8">
        <div class="flex items-start gap-4">
          <span class={tile}><Icon name="tabler:phone" class="size-5" /></span>
          <div>
            <p class="text-sm text-ink/60">Téléphone</p>
            <a href={phoneHref} class="font-heading text-lg font-semibold whitespace-nowrap text-primary transition-colors hover:text-ink">
              {site.phone}
            </a>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class={tile}><Icon name="tabler:clock" class="size-5" /></span>
          <div>
            <p class="text-sm text-ink/60">{days}</p>
            <p class="text-lg text-ink/80">
              <!-- Each slot stays in one piece (whitespace-nowrap): the line
                   can only break between "de 9h à 12h" and "et de 14h à 18h" -->
              {slots.map(([start, end], i) => (
                <>
                  {i > 0 && " "}
                  <span class="whitespace-nowrap">
                    {i > 0 && "et "}de{nb}
                    <span class="font-heading font-semibold text-ink">{start}{nb}à{nb}{end}</span>
                  </span>
                </>
              ))}
            </p>
          </div>
        </div>
      </div>
      <!-- The "extra hours" note as a lime pill, so it doesn't get skipped -->
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent/20 px-4 py-1.5 text-sm font-medium text-ink/80">
        <Icon name="tabler:moon-stars" class="size-4 text-[#6f9426]" />
        {site.hoursNote}
      </p>
    </div>

    <!--
      Right: the map in a rounded card. Decorative (aria-hidden): the title
      already says "Montpellier et tout l'Hérault".
      Everything inside is positioned in % of the card, so it scales with it.
    -->
    <div
      class="relative aspect-square overflow-hidden rounded-4xl border border-white bg-white/70 shadow-[0_24px_60px_-24px_rgb(22_50_79/0.3)]"
      aria-hidden="true"
    >
      <!-- The real map, covering the card -->
      <Image
        src={mapImage}
        alt=""
        widths={[600, 900, 1200]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        class="absolute inset-0 size-full object-cover"
      />

      <!-- The department: light lime tint inside, blue outline -->
      <svg viewBox="0 0 100 100" class="absolute inset-0 size-full">
        <path d={herault} fill="#a8cf45" fill-opacity="0.12" stroke="#317bb9" stroke-opacity="0.8" stroke-width="0.4" stroke-linejoin="round" />
      </svg>

      <!-- Two blue pulses spreading out from Montpellier (white rim so they
           stand out on the green map), the second one half a beat later -->
      <span class="pulse absolute size-24 rounded-full border-2 border-white/80 bg-primary/35" style={`left:${mtp.x}%;top:${mtp.y}%`}></span>
      <span class="pulse absolute size-24 rounded-full border-2 border-white/80 bg-primary/35 [animation-delay:1.4s]" style={`left:${mtp.x}%;top:${mtp.y}%`}></span>

      <!-- Montpellier: glossy label + pin, the tip of the pin on the exact spot -->
      <span
        class="absolute flex -translate-x-1/2 -translate-y-full flex-col items-center"
        style={`left:${mtp.x}%;top:${mtp.y}%`}
      >
        <span class="rounded-full bg-linear-to-b from-secondary to-primary px-3 py-1 font-heading text-sm font-semibold text-white shadow-lg">
          Montpellier
        </span>
        <Icon name="tabler:map-pin-filled" class="-mt-1 size-9 text-primary drop-shadow" />
      </span>

      <!-- Credit required by the OpenStreetMap licence -->
      <span class="absolute right-3 bottom-2 rounded bg-white/70 px-1.5 text-[10px] text-ink/60">
        © OpenStreetMap
      </span>
    </div>
  </div>
</section>

<style>
  /* The pulse grows from Montpellier and fades out, again and again */
  .pulse {
    transform: translate(-50%, -50%) scale(0.2);
    animation: pulse 2.8s ease-out infinite;
  }
  @keyframes pulse {
    to {
      transform: translate(-50%, -50%) scale(2.2);
      opacity: 0;
    }
  }
  /* People who turn off animations get a still, soft circle */
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
