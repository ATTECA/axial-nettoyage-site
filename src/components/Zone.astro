---
// "Zone d'intervention": text, towns, phone + hours on the left,
// a real map of the Hérault on the right (OpenStreetMap, tinted to the site).
// No address: Axial doesn't receive clients, they come to you.
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import mapImage from "../assets/carte-herault.jpg";
import { site, phoneHref } from "../data/site";
import { sectionX, streak, gradientText } from "../lib/layout";

// Main towns. ‑ = non-breaking hyphen: a name never splits across two lines
const communes = [
  "Montpellier", "Castelnau‑le‑Lez", "Lattes", "Pérols", "Mauguio", "Juvignac",
  "Saint‑Jean‑de‑Védas", "Lunel", "Sète", "Frontignan", "Béziers", "Agde",
  "Pézenas", "Clermont‑l’Hérault", "Lodève", "Ganges",
];

// "Lundi au vendredi, 9h–12h et 14h–18h" -> days + time slots, so the times
// can be written in words: "de 9h à 12h et de 14h à 18h"
const [days, times] = site.hours.split(", ");
const slots = times.split(" et ").map((slot) => slot.split("–")); // [["9h","12h"], ["14h","18h"]]
//   = non-breaking space: "9h à 12h" never splits across two lines
const nb = " ";

// Map image: OpenStreetMap tiles (zoom 10) stitched, cropped to a square
// around the Hérault and tinted once at build time (see the commit).
// Its edges: longitude 2.4415° -> 4.2937°, latitude 44.2598° -> 42.9183°.
// Map tiles use the Web Mercator projection, so latitude goes through merc().
const merc = (lat: number) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 360));
const place = (lon: number, lat: number) => ({
  x: ((lon - 2.4415) / 1.8522) * 100,
  y: ((merc(44.2598) - merc(lat)) / (merc(44.2598) - merc(42.9183))) * 100,
});
const mtp = place(3.877, 43.611); // Montpellier

// Outline of the Hérault (open IGN data, via github.com/gregoiredavid/france-geojson),
// projected like the map and simplified: one SVG path in a 100 × 100 box
