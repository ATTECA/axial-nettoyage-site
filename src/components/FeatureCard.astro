---
// White card: blue glossy icon tile, title, lime bar, text.
// Used by the "atouts" cards and the "pour qui" cards.
import { Icon } from "astro-icon/components";
import { streak } from "../lib/layout";

interface Props {
  icon: string;
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<li class="group rounded-3xl border border-white bg-white/70 p-7 text-center shadow-[0_10px_30px_-12px_rgb(22_50_79/0.15)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-14px_rgb(22_50_79/0.25)] motion-reduce:transition-none">
  <!-- Icon tile: blue gradient + top reflection, same family as the glossy buttons -->
  <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-linear-to-br from-secondary to-primary text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.35),0_8px_18px_-8px_rgb(49_123_185/0.7)]">
    <Icon name={icon} class="size-7" />
  </span>
  <h3 class="mt-6 text-xl font-semibold text-balance">{title}</h3>
  <!-- Squeegee streak (style in layout.ts). Stretches on hover -->
  <span class:list={[streak, "mx-auto mt-3 w-20 transition-all duration-300 group-hover:w-28"]}></span>
  <p class="mt-4 text-pretty text-ink/70">{text}</p>
</li>
